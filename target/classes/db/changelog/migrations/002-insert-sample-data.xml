<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="002-insert-sample-data" author="jessica-persou">
        <insert tableName="company">
            <column name="id" value="c1"/>
            <column name="name" value="Empresa Exemplo"/>
            <column name="cnpj" value="12345678000199"/>
            <column name="fantasy_name" value="Exemplo Ltda"/>
            <column name="street" value="Rua das Flores"/>
            <column name="number" value="100"/>
            <column name="city" value="São Paulo"/>
            <column name="state" value="SP"/>
            <column name="country" value="Brasil"/>
            <column name="neighborhood" value="Centro"/>
            <column name="zipcode" value="01000-000"/>
            <column name="phone" value="912345678"/>
            <column name="email" value="email@email.com.br"/>
        </insert>

        <insert tableName="department">
            <column name="id" value="d1"/>
            <column name="name" value="Tecnologia"/>
            <column name="description" value="Departamento de TI"/>
            <column name="section" value="TI"/>
            <column name="active" valueBoolean="true"/>
            <column name="company_id" value="c1"/>
        </insert>

        <insert tableName="employee">
            <column name="id" value="e1"/>
            <column name="name" value="João Silva"/>
            <column name="birthdate" valueDate="1990-05-10"/>
            <column name="cpf" value="12345678901"/>
            <column name="phone" value="11999999999"/>
            <column name="street" value="Rua das Flores"/>
            <column name="number" value="101"/>
            <column name="city" value="São Paulo"/>
            <column name="state" value="SP"/>
            <column name="country" value="Brasil"/>
            <column name="neighborhood" value="Centro"/>
            <column name="zipcode" value="01000-000"/>
            <column name="email" value="joao.silva@exemplo.com"/>
            <column name="salary" valueNumeric="5000.00"/>
            <column name="position" value="DESENVOLVEDOR"/>
            <column name="department_id" value="d1"/>
            <column name="company_id" value="c1"/>
        </insert>
    </changeSet>
</databaseChangeLog>